# ContenZavod Environment Configuration
# Copy to .env and fill in your values

# ── Database ──────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=contenzavod
POSTGRES_USER=cz_user
POSTGRES_PASSWORD=changeme_strong_password_here
DATABASE_URL=postgresql+asyncpg://cz_user:changeme_strong_password_here@postgres:5432/contenzavod

# ── Redis ─────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ── MinIO (Object Storage) ────────────────────────
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=changeme_minio_secret
MINIO_BUCKET=contenzavod
MINIO_USE_SSL=false

# ── Auth ──────────────────────────────────────────
JWT_SECRET_KEY=changeme_jwt_secret_at_least_32_chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── AI Providers ──────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# Kling (Video Generation)
KLING_ACCESS_KEY=your_kling_access_key
KLING_SECRET_KEY=your_kling_secret_key

# ── Telegram ──────────────────────────────────────
# Bot tokens configured per channel in admin panel

# ── YouTube ───────────────────────────────────────
# OAuth credentials configured in admin panel

# ── Application ───────────────────────────────────
APP_NAME=ContenZavod
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000"]
